{
  "name": "@homeassistant-extras/hass-core",
  "version": "0.0.1",
  "author": {
    "name": "Patrick Masters",
    "url": "https://github.com/homeassistant-extras"
  },
  "license": "ISC",
  "description": "Vendored Home Assistant frontend and websocket types/helpers for custom cards.",
  "repository": {
    "type": "git",
    "url": "https://github.com/homeassistant-extras/hass-core.git"
  },
  "exports": {
    "./*": "./src/*"
  },
  "files": [
    "src",
    "AGENTS.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "pass": "yarn format && yarn typecheck && yarn lint && yarn test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "TS_NODE_PROJECT='./tsconfig.test.json' mocha",
    "test:coverage": "nyc yarn run test",
    "test:watch": "TS_NODE_PROJECT='./tsconfig.test.json' mocha --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
