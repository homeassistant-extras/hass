{
  "name": "@homeassistant-extras/hass",
  "version": "0.4.0",
  "author": {
    "name": "Patrick Masters",
    "url": "https://github.com/homeassistant-extras"
  },
  "license": "ISC",
  "prettier": "@homeassistant-extras/config/prettier",
  "description": "Vendored Home Assistant frontend and websocket types/helpers for custom cards.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeassistant-extras/hass.git"
  },
  "types": "./dist/types.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "ci": "yarn build && yarn typecheck && yarn test",
    "pass": "yarn format && yarn ci && yarn lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "TS_NODE_PROJECT='./tsconfig.test.json' mocha",
    "test:coverage": "nyc yarn run test",
    "test:watch": "TS_NODE_PROJECT='./tsconfig.test.json' mocha --watch"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homeassistant-extras/config": "^0.1.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.2",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
